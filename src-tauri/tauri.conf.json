{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MIDA 本地化编辑器",
  "version": "1.0.4",
  "identifier": "com.mida.localization.editor",
  "build": {
    "beforeDevCommand": "npm run prepare:desktop",
    "beforeBuildCommand": "npm run prepare:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "MIDA 本地化编辑器",
      "width": 1280,
      "height": 850,
      "minWidth": 900,
      "minHeight": 640,
      "dragDropEnabled": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' mida-media: http://mida-media.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "离线本地化翻译、版本合并与 ZIP 数据交付",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBMkQyNEVFMjk2MkQ1NzEKUldSeDFXSXA3aVF0R2x3UmRPM2dmQ1o5dUM5ZkdKeHM1ek92MjFCMlNReFM3aVl1N0ZlOUxBSWUK",
      "windows": { "installMode": "passive" }
    }
  }
}
